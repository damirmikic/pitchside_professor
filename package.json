{
  "name": "pitchside-professor",
  "version": "0.1.0",
  "description": "A browser-based football management simulation game with dice-rolling mechanics",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"Pitchside Professor/**/*.{js,html}\"",
    "lint:fix": "eslint \"Pitchside Professor/**/*.{js,html}\" --fix",
    "format": "prettier --write \"Pitchside Professor/**/*.{js,html,css}\"",
    "format:check": "prettier --check \"Pitchside Professor/**/*.{js,html,css}\"",
    "type-check": "tsc --noEmit",
    "optimize-images": "node scripts/optimize-images.js",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "keywords": [
    "game",
    "football",
    "soccer",
    "management",
    "simulation",
    "dice",
    "browser-game",
    "javascript",
    "html5"
  ],
  "author": "Damir Mikic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/damirmikic/pitchside_professor.git"
  },
  "bugs": {
    "url": "https://github.com/damirmikic/pitchside_professor/issues"
  },
  "homepage": "https://github.com/damirmikic/pitchside_professor#readme",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@types/jest": "^29.5.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-html": "^7.1.0",
    "gh-pages": "^6.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.0",
    "sharp": "^0.33.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vite-plugin-html": "^3.2.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "defaults",
    "last 2 versions",
    "> 0.5%",
    "not dead",
    "not ie 11"
  ]
}
